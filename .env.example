PORT=8000
HOST=0.0.0.0

# === Google OAuth2 Credentials ===
# 這些憑證請到 Google Cloud Console (https://console.cloud.google.com/) 取得
# 憑證類型必須是「網頁應用程式 (Web application)」

# 您的用戶端 ID (Client ID)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# 您的用戶端密碼 (Client Secret)
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 授權後重新導向的 URI (Redirect URI)
# 本地開發測試時通常為 http://localhost:3000/api/auth/callback/google
# 部署到 Vercel 後，需要新增正式網址，例如 https://your-app-name.vercel.app/api/auth/callback/google
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# (選用) 用於加密 Session 或 JWT 的密鑰
# 可以使用 `openssl rand -base64 32` 指令生成
NEXTAUTH_SECRET=your_random_secret_string

# === Google Picker（前端雲端檔案選擇器）===
# 啟用 Picker 前，請在同一個 Google Cloud 專案中開啟 Google Picker API。
# GOOGLE_PICKER_CLIENT_ID 可省略；未設定時會沿用 GOOGLE_CLIENT_ID。
# GOOGLE_PICKER_APP_ID 可省略；未設定時會嘗試從 client id 前綴推導專案編號。
GOOGLE_PICKER_API_KEY=your_google_picker_api_key
# GOOGLE_PICKER_CLIENT_ID=your_google_picker_client_id_here.apps.googleusercontent.com
# GOOGLE_PICKER_APP_ID=123456789012
